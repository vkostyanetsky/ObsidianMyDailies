{
	"name": "my-dailies",
	"version": "1.0.0",
	"description": "Works out the properties of a daily note — what was eaten that day, how many tasks are still open — and points from a day to the days and the months around it.",
	"main": "main.js",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"deploy": "npm run build && node scripts/deploy.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian"
	],
	"author": "Vlad Kostyanetsky",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.2",
		"esbuild": "^0.24.2",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
